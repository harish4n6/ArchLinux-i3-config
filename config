# --------- DOOM'S MEDIA & BRIGHTNESS KEYS ----------
# Use NVIDIA backlight device explicitly
set $backlight nvidia_0

# Volume (tries wpctl first, falls back to pactl)
bindsym F2 exec --no-startup-id sh -c 'command -v wpctl >/dev/null \
  && wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- \
  || pactl set-sink-volume @DEFAULT_SINK@ -5%'

bindsym F3 exec --no-startup-id sh -c 'command -v wpctl >/dev/null \
  && wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ \
  || pactl set-sink-volume @DEFAULT_SINK@ +5%'

# Screen brightness on NVIDIA backlight
bindsym F5 exec --no-startup-id brightnessctl -d $backlight set 10%-
bindsym F6 exec --no-startup-id brightnessctl -d $backlight set +10%



